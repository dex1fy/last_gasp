<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="app.Views.AuthView"
             xmlns:vm="using:app.ViewModels"
             x:DataType="vm:AuthViewModel">



    <StackPanel Width="300" Height="200" Spacing="10" HorizontalAlignment="Center">

        <TextBlock Text="Вход" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"></TextBlock>


        <TextBlock Text="Логин"> </TextBlock>
        <TextBox Text="{Binding Login}"> </TextBox>

        <TextBlock Text="Пароль"> </TextBlock>
        <TextBox Text="{Binding Password}" PasswordChar="*"> </TextBox>

        <Button Command="{Binding Enter}" Content="Войти" Width="300" HorizontalContentAlignment="Center" Background="#00FA9A"/>

        <Button Command="{Binding Guest}" Content="Войти как гость" Width="300" HorizontalContentAlignment="Center" Background="#7FFF00"/>

        <TextBlock Text="{Binding Message}" Foreground="Red"></TextBlock>
    </StackPanel>

</UserControl>

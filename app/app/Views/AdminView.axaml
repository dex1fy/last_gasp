<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="app.Views.AdminView"
             xmlns:vm="using:app.ViewModels"
             x:DataType="vm:AdminViewModel">


    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Products}">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <Border BorderBrush="#00FA9A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="5">


                        <Grid ColumnDefinitions="200, *, 150">

                            <Border Grid.Column="0"
                                    Margin="5"
                                    Height="120">

                                <Image Source="/Assets/picture.png"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="5"
                                    Padding="8">

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category.Name}"> </TextBlock>
                                        <TextBlock Text="|"> </TextBlock>
                                        <TextBlock Text="{Binding ProductType.Name}"> </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description, StringFormat = Описание товара: {0} }" > </TextBlock>
                                    <TextBlock Text="{Binding Supplier.Name, StringFormat = Поставщик: {0}}"> </TextBlock>
                                    <TextBlock Text="{Binding Manufacturer.Name, StringFormat = Производитель: {0}}"> </TextBlock>
                                    <TextBlock Text="{Binding Price, StringFormat = Цена: {0}}"> </TextBlock>
                                    <TextBlock Text="{Binding Unit.Name, StringFormat = Единица измерения: {0}}"> </TextBlock>
                                    <TextBlock Text="{Binding StockQuantity, StringFormat = Остаток: {0}}"> </TextBlock>


                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#7FFF00"
                                    BorderThickness="2"
                                    Margin="5">

                                <TextBlock Text="{Binding CurrentDiscount, StringFormat='Действующая скидка: {0}%'}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </ScrollViewer>
</UserControl>
